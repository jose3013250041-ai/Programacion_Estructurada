def calcular_pago(horas, sueldo_hora):
    if horas == 10: p = 0.20
    elif horas == 15: p = 0.30
    elif horas == 20: p = 0.15
    elif horas > 25: p = 0.08
    else: p = 0
    
    aumento = (horas * sueldo_hora) * p
    sueldo_neto = (horas * sueldo_hora) + aumento
    return aumento, sueldo_neto

